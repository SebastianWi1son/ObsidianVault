			"height":60,
			"color":"2"
		},
		{
			"id":"626152c7b00f9f32",
			"type":"text",
			"text":"CODE\n```cpp\nmath::Vec3f Mahony::correction_acc(const math::Vec3f& v, float dt) {\n    // Gating\n    if (!is_acc_valid()) { return math::Vec3f(0.0f, 0.0f, 0.0f); }\n    // 算error\n    const math::Vec3f e_acc = acc_.cross(v);\n    // error integral (also zero offset)\n    e_int_.x_ += e_acc.x_ * dt;\n    e_int_.y_ += e_acc.y_ * dt;\n    e_int_.z_ += e_acc.z_ * dt;\n    // integral limit\n    e_int_.x_ = math::clamp(e_int_.x_, -cfg_.integral_limit_, cfg_.integral_limit_);\n    e_int_.y_ = math::clamp(e_int_.y_, -cfg_.integral_limit_, cfg_.integral_limit_);\n    e_int_.z_ = math::clamp(e_int_.z_, -cfg_.integral_limit_, cfg_.integral_limit_);\n    // 修正折进角速度：ω_corrected = ω + Kp·e + Ki·∫e\n    return math::Vec3f(cfg_.kp_ * e_acc.x_ + cfg_.ki_ * e_int_.x_,\n                       cfg_.kp_ * e_acc.y_ + cfg_.ki_ * e_int_.y_,\n                       cfg_.kp_ * e_acc.z_ + cfg_.ki_ * e_int_.z_);\n}\n```",
			"styleAttributes":{},
			"x":-1440,
			"y":-2240,
			"width":920,
			"height":540
		},
		{
			"id":"bf197f3acc7a412f",
			"type":"text",
			"text":"is_acc_valid()\n",
			"styleAttributes":{},
			"x":-2080,
			"y":-2200,
			"width":180,
			"height":60,
			"color":"6"
		},
