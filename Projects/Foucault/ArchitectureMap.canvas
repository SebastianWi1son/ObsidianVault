		{
			"id":"17be67f767659b8e",
			"type":"text",
			"text":"打滑检测-->降权trust",
			"styleAttributes":{},
			"x":-2080,
			"y":830,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"03ce5cfb1fca8a13",
			"type":"text",
			"text":"CODE\n```cpp\nvoid Mahony::observe_heading(float heading_ref, float trust) {\n    // 首次自动兜底：忘了手动对齐时航向通道也能工作（否则会静默失效）\n    if (!is_heading_aligned_) { align_heading(heading_ref); }\n    heading_ref_ = heading_ref;     // ★ 必须：让本周期目标自洽（否则拿旧 ref 算残差 → 对齐瞬间跳变）\n    heading_trust_ = math::clamp(trust, 0.0f, 1.0f);\n    heading_age_ = 0.0f;            // heading_age_ 唯一清零口\n}\n```",
			"styleAttributes":{},
			"x":-3900,
			"y":680,
			"width":880,
			"height":300
		},
		{
			"id":"8e56237a163d01f9",
			"type":"text",
			"text":"correction_heading\n```cpp\nmath::Vec3f Mahony::correction_heading(const math::Vec3f& v) {\n    // Gating\n    if (!is_heading_valid()) { return math::Vec3f(0.0f, 0.0f, 0.0f); }\n    // 航向残差 = 参考 − 估计；必须 wrap 到 [−π,π] 再限幅（每周期用当前 q̂ 现算，不得冻结）\n    float roll, pitch, psi;\n    q_.to_euler(roll, pitch, psi);\n    float e_heading = math::wrap_pi(heading_ref_ + heading_offset_ - psi);\n    e_heading = math::clamp(e_heading, -k_half_pi, k_half_pi);\n    // 绕世界z轴转 == body系中沿重力方向 v 加角速度（v 由上面的统一消费口给出，本周期只算一次）\n    const float k = cfg_.kp_heading_ * heading_trust_ * e_heading;      // 增益\n    // 该通道的角速度修正项 = 大小 k 沿重力轴 v̂（纯 P）\n    return math::Vec3f(k * v.x_, k * v.y_, k * v.z_);\n}\n```",
			"styleAttributes":{},
			"x":-1307,
			"y":-391,
			"width":780,
			"height":420
		},
		{
			"id":"59146558a1cd36c6",
			"type":"text",
			"text":"is_heading_valid()",
			"styleAttributes":{},
			"x":-2040,
			"y":589,
			"width":180,
			"height":60,
			"color":"6"
		},
