		{"id":"e_observe_to_e_int","fromNode":"n_observe","fromSide":"bottom","toNode":"n_e_int","toSide":"top","label":"e 每帧累加（·dt，限幅）"},
		{"id":"e_e_int_to_k_e","toFloating":false,"fromNode":"n_e_int","fromSide":"left","toNode":"n_k_e","toSide":"bottom","label":"Ki·e_int_（= b̂ 零偏估计）"},
		{"id":"e_k_e_to_omega","fromNode":"n_k_e","fromSide":"top","toNode":"n_omega_c","toSide":"bottom","label":"Kp·e_last_ + Ki·e_int_"},
