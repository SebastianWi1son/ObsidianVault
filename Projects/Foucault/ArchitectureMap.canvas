			"color":"1"
		},
		{
			"id":"a7905b76b1ce6edb",
			"type":"text",
			"text":"align_heading\n```cpp\nvoid Mahony::align_heading(float heading_ref) {\n    float roll, pitch, psi;\n    q_.to_euler(roll, pitch, psi);              // 初始化\n    heading_offset_ = math::wrap_pi(psi - heading_ref);\n    heading_ref_ = heading_ref;\n    is_heading_aligned_ = true;\n}\n```",
			"styleAttributes":{},
			"x":-4240,
			"y":-40,
			"width":560,
			"height":280,
			"color":"6"
		},
