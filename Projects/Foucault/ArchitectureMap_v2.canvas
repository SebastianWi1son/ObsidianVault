		{"id":"bc004fd12dd5a076","type":"text","text":"⚠ 本资产内容仍是旧版\n（is_meas_ / e_last_）—— 待刷新","x":940,"y":1860,"width":620,"height":120},
		{"id":"f276964873f98252","type":"file","file":"Projects/Foucault/assets/struct IMUSample.md","x":-3280,"y":515,"width":400,"height":190},
		{"id":"7f5d5f84a4b0ac39","type":"text","text":"observe(acc)\n· normalize → 存入 acc_\n· acc_age_ = 0","x":-2640,"y":260,"width":400,"height":150},
		{"id":"bafce0cb799d5729","type":"text","text":"gyro_ 原样透传给 predict（不存）","x":-2680,"y":940,"width":400,"height":90},
		{"id":"8bb24a7f247613ae","type":"text","text":"acc_（归一化量测）\nacc_age_ = 0","x":-2020,"y":280,"width":400,"height":110},
