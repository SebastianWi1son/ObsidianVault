	"nodes":[
		{"id":"16350f0d2acc4412","type":"group","x":-7080,"y":-40,"width":2640,"height":1390,"label":"① 收集口 observe*（只装量测，不算残差）"},
		{"id":"237f12f20de147e8","type":"group","x":200,"y":120,"width":1420,"height":2020,"label":"③ Mahony::predict()：统一消费口（修正 + 推进）"},
		{"id":"1b60465ab39f75ae","type":"text","text":"正交性：e_acc = a × v̂ 必垂直于 v̂ ⇒ acc 通道对 yaw 贡献【恒为 0】\n⇒ 航向通道不是第二次修正，而是填补一个数学上无人负责的自由度","x":260,"y":1430,"width":1300,"height":160},
		{"id":"a525114a7f68e71e","type":"text","text":"门控：残差过期就【不用它修正】（P0-4 年龄计数器）\n所有残差在 predict 里用【当前】q̂ 现算，不得冻结（4a-2 统一消费口）","x":260,"y":1650,"width":1300,"height":160},
		{"id":"bc004fd12dd5a076","type":"text","text":"⚠ 本资产内容仍是旧版\n（is_meas_ / e_last_）—— 待刷新","x":1500,"y":1920,"width":60,"height":60},
		{"id":"bafce0cb799d5729","type":"text","text":"gyro_ 原样透传给 predict（不存）","x":-6320,"y":780,"width":400,"height":90},
		{"id":"7f5d5f84a4b0ac39","type":"text","text":"observe(acc)\n· normalize → 存入 acc_\n· acc_age_ = 0","x":-6280,"y":100,"width":400,"height":150},
		{"id":"11a5b604d31843d3","type":"text","text":"外部航向参考\n里程计 / 磁力计 / RTK","x":-6120,"y":1080,"width":480,"height":190},
		{"id":"8bb24a7f247613ae","type":"text","text":"acc_（归一化量测）\nacc_age_ = 0","x":-5660,"y":120,"width":400,"height":110},
		{"id":"e57eaa57f3bab051","type":"text","text":"observe_heading(ref, trust)\n· 首次：自动对齐 offset = ψ̂ − ref\n· 存 ref / trust，heading_age_ = 0","x":-5320,"y":1080,"width":480,"height":160},
		{"id":"cc1b950997474987","type":"text","text":"heading_ref_ / heading_trust_\nheading_age_ = 0","x":-5210,"y":405,"width":480,"height":110},
		{"id":"efe913deca25ea51","type":"text","text":"acc 通道（门控：is_acc_valid()）\ne_acc = acc_ × v̂","x":-1880,"y":465,"width":620,"height":150},
		{"id":"4ca64a3b3f7c8e7c","type":"text","text":"trust ∈ [0,1]\n上层：打滑检测 → 降权","x":1900,"y":360,"width":620,"height":130},
		{"id":"a09ab171813b4b29","type":"text","text":"wrap_pi\n（批次 4a 新增，core/math 解冻一次）","x":800,"y":520,"width":620,"height":150},
		{"id":"01bea17eb0aacf0a","type":"text","text":"acc_age_ += dt\nheading_age_ += dt","x":320,"y":1260,"width":620,"height":130},
		{"id":"44c71a1ec9104220","type":"text","text":"ω = gyro_ + (Kp·e_acc + Ki·e_int_) + (Kp_heading·trust·e_h·v̂)\n（Mahony：所有修正都折进角速度）","x":-220,"y":1060,"width":1300,"height":150},
		{"id":"f20f473f28e59195","type":"text","text":"e_int_ += e_acc·dt\n（clamp ±integral_limit_）","x":-680,"y":560,"width":620,"height":150},
		{"id":"9959919da125b463","type":"text","text":"heading 通道（门控：is_heading_valid()）\ne_h = wrap_pi(ref + offset − ψ̂)\nclamp ±π/2","x":-1880,"y":200,"width":620,"height":150}
