	"nodes":[
		{"id":"16350f0d2acc4412","type":"group","x":-3440,"y":120,"width":2640,"height":1390,"label":"① 收集口 observe*（只装量测，不算残差）"},
		{"id":"237f12f20de147e8","type":"group","x":200,"y":120,"width":1420,"height":2020,"label":"③ Mahony::predict()：统一消费口（修正 + 推进）"},
		{"id":"37acb6d2553db694","type":"group","x":1900,"y":120,"width":900,"height":900,"label":"④ Quat::integrate()（core/math，已归档）"},
		{"id":"7a910154581a08a7","type":"group","x":-1840,"y":1700,"width":1760,"height":440,"label":"② 门控 · 品质查询（告诉调用方能不能信）"},
		{"id":"33f99f10ddfe9473","type":"text","text":"is_acc_valid()\n  acc_age_ ≤ acc_timeout_","x":-1800,"y":1780,"width":460,"height":130},
		{"id":"9873e4bba2c07586","type":"text","text":"【统一消费口】v̂ = q̂*·(0,0,1)\n重力方向在机体系里的表达 —— 本周期【只算一次】，两通道共用","x":260,"y":200,"width":1300,"height":130},
		{"id":"efe913deca25ea51","type":"text","text":"acc 通道（门控：is_acc_valid()）\ne_acc = acc_ × v̂","x":260,"y":390,"width":620,"height":150},
		{"id":"f20f473f28e59195","type":"text","text":"e_int_ += e_acc·dt\n（clamp ±integral_limit_）","x":260,"y":580,"width":620,"height":150},
		{"id":"9959919da125b463","type":"text","text":"heading 通道（门控：is_heading_valid()）\ne_h = wrap_pi(ref + offset − ψ̂)\nclamp ±π/2","x":940,"y":390,"width":620,"height":150},
		{"id":"a09ab171813b4b29","type":"text","text":"wrap_pi\n（批次 4a 新增，core/math 解冻一次）","x":940,"y":580,"width":620,"height":150},
		{"id":"44c71a1ec9104220","type":"text","text":"ω = gyro_ + (Kp·e_acc + Ki·e_int_) + (Kp_heading·trust·e_h·v̂)\n（Mahony：所有修正都折进角速度）","x":260,"y":780,"width":1300,"height":150},
		{"id":"01bea17eb0aacf0a","type":"text","text":"acc_age_ += dt\nheading_age_ += dt","x":260,"y":980,"width":620,"height":130},
		{"id":"4ca64a3b3f7c8e7c","type":"text","text":"trust ∈ [0,1]\n上层：打滑检测 → 降权","x":940,"y":980,"width":620,"height":130},
		{"id":"0c90b0d453f40639","type":"text","text":"q_\n（姿态状态：整个 core 唯一被写的位置）","x":1940,"y":900,"width":820,"height":90},
		{"id":"1b60465ab39f75ae","type":"text","text":"正交性：e_acc = a × v̂ 必垂直于 v̂ ⇒ acc 通道对 yaw 贡献【恒为 0】\n⇒ 航向通道不是第二次修正，而是填补一个数学上无人负责的自由度","x":260,"y":1430,"width":1300,"height":160},
		{"id":"a525114a7f68e71e","type":"text","text":"门控：残差过期就【不用它修正】（P0-4 年龄计数器）\n所有残差在 predict 里用【当前】q̂ 现算，不得冻结（4a-2 统一消费口）","x":260,"y":1650,"width":1300,"height":160},
		{"id":"72a1f0f8cc9bfd9d","type":"text","text":"q̇ = ½·q ⊗ (0,ω)","x":1940,"y":200,"width":820,"height":90},
		{"id":"946c970cabf5d943","type":"text","text":"q_k+1 = normalize(q_k + q̇·dt)","x":1940,"y":330,"width":820,"height":90},
		{"id":"f080cb6cc22cc18b","type":"file","file":"Projects/Foucault/assets/integrate().md","x":1940,"y":460,"width":400,"height":400},
