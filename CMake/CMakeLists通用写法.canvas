{
	"nodes":[
		{"id":"n0","type":"text","text":"CMakeLists 通用写法（骨架 + 四区按需加减）","x":0,"y":916,"width":300,"height":62},
		{"id":"n1","type":"text","text":"🦴 骨架区（任何 C/C++ 项目必留）","x":410,"y":142,"width":300,"height":62},
		{"id":"n2","type":"text","text":"cmake_minimum_required(VERSION 3.x)　← 版本门槛","x":820,"y":0,"width":300,"height":62},
		{"id":"n3","type":"text","text":"project(包名)　← 名字，${PROJECT_NAME} 到处引用","x":820,"y":88,"width":300,"height":62},
		{"id":"n4","type":"text","text":"① 编译选项（可选）","x":820,"y":240,"width":300,"height":42},
		{"id":"n5","type":"text","text":"-Wall -Wextra -Wpedantic　← 学习期留","x":1230,"y":176,"width":300,"height":62},
		{"id":"n6","type":"text","text":"CMAKE_CXX_STANDARD 17　← 嵌入式留 / ROS 可删（ament 默认）","x":1230,"y":264,"width":300,"height":82},
		{"id":"n7","type":"text","text":"❓ 需求判断 → 决定 ②③④ 三个区填什么","x":410,"y":862,"width":300,"height":62},
		{"id":"n8","type":"text","text":"Q② 我的代码 include 了谁的头？","x":820,"y":524,"width":300,"height":62},
		{"id":"n9","type":"text","text":"系统自带的（std/pthread）──→ 什么都不写","x":1230,"y":372,"width":300,"height":62},
		{"id":"n10","type":"text","text":"自己项目内的头目录 ──→ target_include_directories(target PRIVATE 目录)","x":1230,"y":460,"width":300,"height":82},
		{"id":"n12","type":"text","text":"ROS 视角：ament_cmake / rclcpp / example_interfaces / geometry_msgs...","x":1640,"y":568,"width":300,"height":82},
		{"id":"n13","type":"text","text":"嵌入式视角：OpenCV / Eigen...","x":1640,"y":676,"width":300,"height":62},
		{"id":"n14","type":"text","text":"Q③ 我产出什么 target？它靠什么跑？","x":820,"y":916,"width":300,"height":62},
		{"id":"n15","type":"text","text":"add_executable(名 源文件...)　← 可执行","x":1230,"y":764,"width":300,"height":62},
		{"id":"n16","type":"text","text":"add_library(...)　← 给别人用的库（进阶）","x":1230,"y":852,"width":300,"height":62},
		{"id":"n17","type":"text","text":"把依赖\"接上\" target（二选一）","x":1230,"y":1004,"width":300,"height":62},
		{"id":"n18","type":"text","text":"嵌入式写法：target_include_directories + target_link_libraries(变量)","x":1640,"y":940,"width":300,"height":82},
		{"id":"n19","type":"text","text":"ROS 写法：ament_target_dependencies(名 rclcpp example_interfaces)","x":1640,"y":1048,"width":300,"height":82},
		{"id":"n20","type":"text","text":"= 三合一（头路径 + 库 + 依赖链自动传播）← imported target 思想","x":2050,"y":1048,"width":300,"height":82},
		{"id":"n21","type":"text","text":"Q④ 产物需要被\"外部\"找到吗？","x":820,"y":1254,"width":300,"height":62},
		{"id":"n22","type":"text","text":"是·ROS 生态 ──→ install(TARGETS 名 DESTINATION lib/${PROJECT_NAME})","x":1230,"y":1156,"width":300,"height":82},
		{"id":"n23","type":"text","text":"ros2 run 从 install/ 找可执行　← 必留","x":1640,"y":1156,"width":300,"height":62},
		{"id":"n24","type":"text","text":"是·作为库给别人 include（进阶）","x":1230,"y":1264,"width":300,"height":62},
		{"id":"n25","type":"text","text":"否·自己跑 build/app ──→ ④ 整段删除（嵌入式常态）","x":1230,"y":1352,"width":300,"height":62},
		{"id":"n26","type":"text","text":"🔚 收尾（按生态分叉，只留一条）","x":410,"y":1474,"width":300,"height":62},
		{"id":"n27","type":"text","text":"ROS：ament_package()（必须在文件末尾）","x":820,"y":1440,"width":300,"height":62},
		{"id":"n28","type":"text","text":"嵌入式：无","x":820,"y":1528,"width":300,"height":42},
		{"id":"n29","type":"text","text":"🚨 排错速查（错 ↔ 漏哪区，反查）","x":410,"y":1714,"width":300,"height":62},
		{"id":"n30","type":"text","text":"\"Could not find a package configuration...\" ──→ 漏 ② find_package","x":820,"y":1596,"width":300,"height":82},
		{"id":"n31","type":"text","text":"\"xxx.hpp: No such file or directory\" ──→ 漏 ③ 接依赖（ROS: ament_target_dependencies）","x":820,"y":1704,"width":300,"height":102},
		{"id":"n32","type":"text","text":"colcon 成功但 \"ros2 run 找不到\" ──→ 漏 ④ install","x":820,"y":1832,"width":300,"height":62},
		{"id":"n11","type":"text","text":"外部包的（第三方 / 别的 ROS 包）──→ find_package(包名 REQUIRED)","x":1230,"y":609,"width":300,"height":82}
	],
